# === IA (solo servidor) ===
# Clave de Anthropic para generar el contenido de las peticiones con Claude.
# Sin esta clave, la app usa un generador de plantilla determinística (útil en dev).
ANTHROPIC_API_KEY=
# Modelo a usar. Por defecto: claude-sonnet-5 (alternativa de mayor calidad: claude-opus-4-8).
LLM_MODEL=claude-sonnet-5

# === Supabase (Incremento 3: auth + guardado) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
